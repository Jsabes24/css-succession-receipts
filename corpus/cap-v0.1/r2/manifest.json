  "revision": 2,
  "keys": {
    "cap-vector-1": "../../keys/cap-vector.pub.pem"
  },
  "cases": [
    {
      "name": "golden",
      "file": "golden.json",
      "eval_at": "2026-07-06T12:00:30Z",
      "expect": "pass"
    },
    {
      "name": "golden-expired",
      "file": "golden.json",
      "eval_at": "2026-07-06T12:10:00Z",
      "expect": "fail",
      "failing_check": "window",
      "note": "same credential evaluated after expires_at"
    },
    {
      "name": "golden-not-yet-valid",
      "file": "golden.json",
      "eval_at": "2026-07-06T11:00:00Z",
      "expect": "fail",
      "failing_check": "window"
    },
    {
      "name": "capability-altered",
      "file": "capability-altered.json",
      "eval_at": "2026-07-06T12:00:30Z",
      "expect": "fail",
      "failing_check": "proof"
    },
    {
      "name": "deny-basis",
      "file": "deny-basis.json",
      "eval_at": "2026-07-06T12:00:30Z",
      "expect": "fail",
      "failing_check": "basis",
      "note": "a validly signed credential must still never carry a deny as its basis"
    },
    {
      "name": "proof-signature-bitflip",
      "file": "proof-signature-bitflip.json",
      "eval_at": "2026-07-06T12:00:30Z",
      "expect": "fail",
      "failing_check": "proof"
    },
    {
      "name": "capability-extra-member",
      "file": "capability-extra-member.json",
      "eval_at": "2026-07-06T12:00:30Z",
      "expect": "fail",
      "failing_check": "proof",
      "note": "golden plus one member the format does not define (subject.extra); the signed content is the document as received minus proof (spec \u00a73), so the recomputed hash differs and the proof fails. A verifier that decodes into a typed struct and drops unknown members before hashing would pass it \u2014 that is the divergence this case exists to catch."
    }
  ]
